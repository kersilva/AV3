// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================
// ENUMS — existentes (AV1/AV2)
// ====================

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

// ====================
// ENUMS — novos (AV3)
// ====================

// Metodologia usada para gerar uma previsão de vida útil.
// Persistir qual método foi usado permite comparar a qualidade dos modelos.
enum MetodologiaPrevisao {
  REGRESSAO_OLS
  SUAVIZACAO_EXPONENCIAL
}

// Estado de uma solicitação de relatório assíncrona.
// Acompanha o ciclo de vida da intenção de negócio no Postgres;
// o estado do job em si (em fila, em execução, retentando) fica no Redis/BullMQ.
enum StatusSolicitacao {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHOU
  CANCELADO
}

enum TipoRelatorio {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE_POR_TIPO
  PREVISAO_VIDA_UTIL
  COMPLETO
}

enum MetricaAnalise {
  EFICIENCIA_TEMPO_MEDIO_TRIAGEM_HORAS
  EFICIENCIA_LOTES_CONCLUIDOS
  EFICIENCIA_LOTES_PENDENTES
  RECUPERACAO_MEDIA_BRUTA
  RECUPERACAO_AMOSTRAS
  VIDA_UTIL_INCLINACAO
  VIDA_UTIL_INTERCEPTO
  VIDA_UTIL_R2
  VIDA_UTIL_PREVISTA_MESES
  VIDA_UTIL_RESTANTE_MESES
  VIDA_UTIL_AMOSTRAS
}

enum NivelEstimativaRecuperacao {
  CORRESPONDENCIA_COMPLETA
  TIPO_ESTADO
}

enum StatusOutboxRelatorio {
  PENDENTE
  PUBLICADO
}

// Escopos de uma chave de API. Enum em vez de String[] para evitar o mesmo
// problema de typos que corrigimos em Movimentacao.origem/destino: permissões
// diferentes por erro de digitação, sem erro em runtime.
enum EscopoApi {
  RASTREABILIDADE_LEITURA
  LOTE_ESCRITA
  RELATORIO_LEITURA
}

// ====================
// MODELS — Camada transacional (AV1/AV2, preservada)
// ====================

model Usuario {
  id           String       @id
  usuario      String       @unique
  hashSenha    String
  ultimoAcesso DateTime?
  papel        PapelUsuario
  ativo        Boolean      @default(true)
  versao       Int          @default(1)

  journalTransacoes     JournalTransacao[]
  movimentacoes         Movimentacao[]
  historicoStatusLote   HistoricoStatusLote[]
  historicoEstadoFisico HistoricoEstadoFisico[]
  solicitacoesRelatorio SolicitacaoRelatorio[]
}

model JournalTransacao {
  id                 String   @id
  timestamp          DateTime @default(now())
  operacao           String
  entidade           String
  dadosAntes         Json?
  dadosDepois        Json?
  usuarioId          String?
  usuarioResponsavel String

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([timestamp])
  @@index([entidade, timestamp])
  @@index([usuarioId])
}

model ConfiguracaoSistema {
  id                     Int     @id @default(1)
  aliquotaImposto        Decimal @db.Decimal(5, 4)
  coeficienteDepreciacao Decimal @db.Decimal(5, 4)
  versao                 Int     @default(1)
}

model Movimentacao {
  id            String             @id
  equipamentoId String
  dataHora      DateTime
  // AV3: antes eram String livre — viraram enum para evitar fragmentação
  // em GROUP BY (typos como "EM_DESMONTE" vs "em_desmonte" quebravam qualquer
  // agregação por etapa do fluxo de rastreamento).
  origem        StatusRastreamento
  destino       StatusRastreamento
  // AV3: antes era `responsavel String` (texto livre, o nome do operador).
  // Virou FK para Usuario para uniformizar com HistoricoStatusLote/HistoricoEstadoFisico
  // e permitir JOIN entre as três tabelas na análise por operador. Nullable porque
  // uma movimentação pode ser disparada pelo sistema (ex.: rotina automática).
  responsavelId String?
  observacao    String?
  versao        Int                @default(1)

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id])
  responsavel Usuario?    @relation(fields: [responsavelId], references: [id])

  @@index([equipamentoId])
  @@index([destino, dataHora])
  @@index([responsavelId])
}

model ClausulaContrato {
  contratoId String
  ordem      Int
  texto      String

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@id([contratoId, ordem])
}

model Contrato {
  id                  String             @id
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           ClausulaContrato[]
  valorMensal         Decimal            @db.Decimal(12, 2)
  renovacaoAutomatica Boolean
  versao              Int                @default(1)
  excluidoEm          DateTime?

  organizacaoId String
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
}

model Equipamento {
  posicaoNoLote         Int
  historicoMovimentacao Movimentacao[]
  // AV3: trajetória de estado físico por equipamento.
  // Alimenta a análise preditiva (idade na morte por tipo) e, ao mesmo tempo,
  // satisfaz a regra da AV1/AV2 de justificativa obrigatória em queda >= 2 categorias.
  historicoEstadoFisico HistoricoEstadoFisico[]
  // AV3: validações de previsão — quando um equipamento vira INSERVIVEL após
  // dataPrevisao de uma PrevisaoVidaUtil, registra-se aqui o erro cometido.
  validacoesPrevisao    ValidacaoPrevisao[]

  id                  String             @id
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Decimal            @db.Decimal(10, 2)
  loteId              String
  statusRastreamento  StatusRastreamento
  versao              Int                @default(1)
  excluidoEm          DateTime?

  // AV3: rentabilidade — abordagem híbrida.
  //   valorEstimadoRecuperacao  -> preenchido na triagem (com base em tipo/estado/marca/modelo)
  //   valorRealizadoRecuperacao -> preenchido no desmonte (valor efetivo)
  // A diferença entre os dois vira métrica analítica: precisão da estimativa por tipo.
  // NOTA PARA O RELATÓRIO: valorRealizadoRecuperacao é BRUTO. Para rentabilidade
  // líquida, o service deve descontar aliquotaImposto (ConfiguracaoSistema) e custos
  // de processo. Decidir e declarar explicitamente qual versão está sendo reportada.
  valorEstimadoRecuperacao  Decimal?  @db.Decimal(10, 2)
  valorRealizadoRecuperacao Decimal?  @db.Decimal(10, 2)
  dataEstimativa            DateTime?
  amostrasEstimativa        Int?
  nivelEstimativa           NivelEstimativaRecuperacao?
  dataRealizacao            DateTime?
  referenciaComprovante     String?

  lote Lote @relation(fields: [loteId], references: [id])

  @@unique([loteId, posicaoNoLote])
  @@index([tipo, marca, modelo])
}

model Lote {
  id          String   @id
  dataEntrada DateTime

  organizacaoId       String
  notaFiscal          String
  transportadora      String
  equipamentos        Equipamento[]
  statusProcessamento StatusLote
  observacoes         String?
  versao              Int           @default(1)
  excluidoEm          DateTime?

  // AV3: histórico de transições de status do lote.
  // statusProcessamento é apenas a foto do presente; este array alimenta
  // a análise de eficiência (tempo entrada -> triagem concluída, por operador, por período).
  historicoStatus HistoricoStatusLote[]

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])

  @@index([organizacaoId])
}

model Organizacao {
  id                String    @id
  razaoSocial       String
  cnpj              String    @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime  @default(now())
  excluidoEm        DateTime?
  versao            Int       @default(1)

  contratoVigente Contrato[]
  lotes           Lote[]
  parceirosApi    ParceiroApi[]
}

// ====================
// MODELS — Camada temporal (NOVO — AV3)
//
// O schema transacional guarda apenas o valor presente de cada estado.
// A camada analítica precisa do "quando" cada estado foi assumido, porque
// quase tudo que ela calcula é uma diferença de tempo ou uma tendência.
// Estas tabelas registram o que só existia no momento da transição.
// ====================

// Cada mudança de statusProcessamento de um Lote.
// Regra de preenchimento (no service, dentro de $transaction):
//   toda atualização de Lote.statusProcessamento deve inserir uma linha aqui
//   com statusAnterior = valor antes da mudança (ou null na criação inicial),
//   statusNovo = valor depois.
// statusAnterior é NULLABLE: a primeira linha, registrada no momento da criação
// do lote, tem statusAnterior = null.
//
// Tempo de triagem de UM lote:
//   (primeiro timestamp com statusNovo = TRIAGEM_CONCLUIDA)
//   - (primeiro timestamp com statusNovo = EM_TRIAGEM)
//   calculado separadamente para cada loteId.
// A média é calculada sobre os lotes, nunca subtraindo timestamps de lotes diferentes.
// Tempo total de entrada até a conclusão: use o timestamp da linha com
// statusAnterior = null como início, em vez de Lote.dataEntrada, se quiser
// medir desde o registro no sistema.

model HistoricoStatusLote {
  id             String      @id
  loteId         String
  statusAnterior StatusLote?
  statusNovo     StatusLote
  timestamp      DateTime    @default(now())
  responsavelId  String? // nullable: transições automáticas (cron, sistema) não têm usuário
  observacao     String?

  lote        Lote     @relation(fields: [loteId], references: [id])
  responsavel Usuario? @relation(fields: [responsavelId], references: [id])

  @@index([loteId, timestamp])
  @@index([statusNovo, timestamp])
  @@index([responsavelId])
}

// Cada mudança de estadoFisico de um Equipamento.
// Regra de preenchimento (no service, dentro de $transaction):
//   toda atualização de Equipamento.estadoFisico deve inserir uma linha aqui.
//   Se |ordem(estadoNovo) - ordem(estadoAnterior)| >= 2 (queda de 2+ categorias),
//   justificativa passa a ser obrigatória — validação no service, não no banco.
// IMPORTANTE: a ordem canônica dos estados NÃO deve ser inferida da ordem de
// declaração do enum no schema. Defina explicitamente no service:
//   const ORDEM_ESTADO: Record<EstadoFisico, number> = { NOVO: 0, BOM_ESTADO: 1, ... };
// estadoAnterior é NULLABLE pelo mesmo motivo que statusAnterior: na criação do
// equipamento registra-se a primeira linha com null.
// Esta mesma tabela satisfaz a regra da AV1/AV2 que estava apenas "operacional"
// (registrada no JournalTransacao como diff JSON), e agora fica modelada e
// consultável analiticamente.
model HistoricoEstadoFisico {
  id             String        @id
  equipamentoId  String
  estadoAnterior EstadoFisico?
  estadoNovo     EstadoFisico
  timestamp      DateTime      @default(now())
  responsavelId  String?
  justificativa  String?

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id])
  responsavel Usuario?    @relation(fields: [responsavelId], references: [id])

  @@index([equipamentoId, timestamp])
  @@index([estadoNovo, timestamp])
  @@index([responsavelId])
}

// ====================
// MODELS — Persistência de resultados analíticos (NOVO — AV3)
//
// O enunciado exige que os relatórios analíticos fiquem disponíveis para
// consulta histórica e que as previsões possam ser confrontadas com o
// realizado posteriormente. Sem estas tabelas, o número calculado some quando
// a consulta termina — e a comparação previsão vs. realizado é impossível.
// ====================

model ExecucaoAnalise {
  id             String             @id
  tipoRelatorio  TipoRelatorio
  parametros     Json
  versaoCalculo  String
  dataReferencia DateTime
  criadaEm       DateTime           @default(now())
  resultados     ResultadoAnalise[]
  previsoes      PrevisaoVidaUtil[]

  @@index([tipoRelatorio, criadaEm])
}

model ResultadoAnalise {
  id         String         @id
  execucaoId String
  metrica    MetricaAnalise
  chave      String         @default("")
  valor      Decimal        @db.Decimal(14, 4)
  amostras   Int

  execucao ExecucaoAnalise @relation(fields: [execucaoId], references: [id], onDelete: Cascade)

  @@unique([execucaoId, metrica, chave])
  @@index([execucaoId])
}

// Uma previsão de vida útil por (tipo, marca?, modelo?).
// Alvo da regressão é o TIPO, não a unidade — cada equipamento que já virou
// INSERVIVEL contribui com um ponto (idade na morte) na regressão daquele tipo.
model PrevisaoVidaUtil {
  id                     String              @id
  tipoEquipamento        TipoEquipamento
  marca                  String?
  modelo                 String?
  dataPrevisao           DateTime            @default(now())
  metodologia            MetodologiaPrevisao
  vidaUtilEstimadaMeses  Decimal              @db.Decimal(10, 2)
  r2                     Decimal?            @db.Decimal(6, 4) // coeficiente de determinação
  amostras               Int // n que alimentou a regressão
  parametros             Json // slope, intercept, etc — transparência
  solicitacaoRelatorioId String? // se veio de um job assíncrono
  execucaoAnaliseId      String?

  solicitacao SolicitacaoRelatorio? @relation(fields: [solicitacaoRelatorioId], references: [id])
  execucao    ExecucaoAnalise?      @relation(fields: [execucaoAnaliseId], references: [id])
  validacoes  ValidacaoPrevisao[]

  @@index([tipoEquipamento, marca, modelo, dataPrevisao])
}

// Resultado da comparação entre uma previsão e um óbito real.
//
// Regra metodológica CRÍTICA (entra no relatório): um equipamento que estava
// no conjunto de TREINO da regressão (virou INSERVIVEL antes de dataPrevisao)
// NÃO pode ser usado para validar o modelo — seria usar dado de treino como
// teste. Só são elegíveis para validação os equipamentos cujo óbito
// (timestamp em HistoricoEstadoFisico com estadoNovo = INSERVIVEL) ocorreu
// DEPOIS de PrevisaoVidaUtil.dataPrevisao.
//
// Viés de sobrevivência (relatório): a regressão treina apenas com equipamentos
// que já morreram, ignorando os ainda em uso que já passaram da idade estimada.
// Tende a subestimar a vida útil. Reportar n de óbitos vs n em serviço acima
// da previsão; Kaplan-Meier seria a técnica correta para observações censuradas.
//
// Base de idade (relatório): usar Lote.dataEntrada como "nascimento em custódia"
// — mede tempo em estoque, não vida desde fabricação. anoFabricacao é ano-preciso
// e fica como dado descritivo, não como base de cálculo.
model ValidacaoPrevisao {
  id                String   @id
  previsaoId        String
  equipamentoId     String
  idadeRealMeses    Decimal @db.Decimal(10, 2) // idade do equipamento no óbito, em meses
  erroAbsolutoMeses Decimal @db.Decimal(10, 2) // |idadeReal - vidaUtilEstimada| da previsão
  registradaEm      DateTime @default(now())

  previsao    PrevisaoVidaUtil @relation(fields: [previsaoId], references: [id])
  equipamento Equipamento      @relation(fields: [equipamentoId], references: [id])

  @@unique([previsaoId, equipamentoId])
  @@index([previsaoId])
}

// ====================
// MODELS — Camada de integração: API pública (NOVO — AV3)
//
// Endpoint público exige identidade de parceiro (para aplicar permissões
// e rate limit por cliente). JWT continua sendo para humanos (API interna);
// a chave de API é para sistemas externos.
// ====================

model ParceiroApi {
  id           String   @id
  nome         String
  emailContato String
  ativo        Boolean  @default(true)
  dataCriacao  DateTime @default(now())
  organizacaoId String

  organizacao  Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  chaves       ChaveApi[]
  solicitacoes SolicitacaoRelatorio[]
  idempotencias IdempotenciaApi[]
}

model IdempotenciaApi {
  id           String   @id
  parceiroId   String
  chave        String
  fingerprint  String
  statusCode   Int
  resposta     Json
  criadaEm     DateTime @default(now())

  parceiro ParceiroApi @relation(fields: [parceiroId], references: [id], onDelete: Cascade)

  @@unique([parceiroId, chave])
  @@index([criadaEm])
}

// Padrão Stripe/GitHub: a chave crua é mostrada uma única vez na geração;
// guardamos apenas o hash SHA-256 (para lookup em O(1) no auth) e um prefixo
// legível para identificar a chave em logs sem expor o segredo.
// escopos: enum EscopoApi[] — granularidade por contrato comercial, sem risco
// de typos criarem permissões fantasmas.
model ChaveApi {
  id            String      @id
  parceiroId    String
  chaveHash     String      @unique
  prefixo       String      @unique
  escopos       EscopoApi[]
  dataCriacao   DateTime    @default(now())
  dataRevogacao DateTime?
  ultimaVez     DateTime?

  parceiro ParceiroApi @relation(fields: [parceiroId], references: [id])

  @@index([parceiroId])
}

// ====================
// MODELS — Orquestração assíncrona (NOVO — AV3)
//
// Postgres é a fonte da verdade da intenção de negócio; BullMQ/Redis apenas
// executam. O fluxo:
//   1. POST /api/v1/public/relatorios -> cria SolicitacaoRelatorio (PENDENTE)
//                                         + publica job no BullMQ -> 202 + id
//   2. Worker pega o job, atualiza status para PROCESSANDO
//   3. Worker executa o service analítico, gera o arquivo
//   4. Worker faz $transaction atualizando status=CONCLUIDO + resultUrl
//   5. Cliente consulta GET /status/{id} (polling) ou recebe webhook
// Em caso de falha: tentativas++ e status=FALHOU após esgotar política de retry.
// Nunca sincronizar nos dois sentidos — Redis pode queimar sem perder a intenção.
//
// Idempotência: chaveIdempotencia recebida via header Idempotency-Key.
// @@unique([parceiroId, chaveIdempotencia]) com ambos nullable: em Postgres,
// NULL != NULL, então múltiplas linhas sem chave são permitidas; a unicidade
// só se aplica quando o parceiro envia a chave. Para usuários internos
// (parceiroId null) a idempotência não é aplicada — eles não têm header.
// ====================

model SolicitacaoRelatorio {
  id                String            @id
  parceiroId        String? // se veio pela API pública
  usuarioId         String? // se veio por usuário interno
  tipoRelatorio     TipoRelatorio
  parametros        Json // filtros: organizacaoId?, periodo?, etc.
  status            StatusSolicitacao @default(PENDENTE)
  jobIdFila         String? // ID do BullMQ, para correlação
  resultUrl         String? // onde baixar quando pronto
  erroMensagem      String?
  resultado         Json? // resumo persistido na mesma transação dos resultados analíticos
  tentativas        Int               @default(0)
  processamentoIniciadoEm DateTime? // primeira tentativa iniciada
  ultimaTentativaIniciadaEm DateTime? // início da tentativa atual/mais recente
  duracaoProcessamentoMs Int @default(0) // soma das tentativas que terminaram
  criadoEm          DateTime          @default(now())
  concluidoEm       DateTime?
  chaveIdempotencia String? // header Idempotency-Key do parceiro

  parceiro  ParceiroApi?       @relation(fields: [parceiroId], references: [id])
  usuario   Usuario?           @relation(fields: [usuarioId], references: [id])
  previsoes PrevisaoVidaUtil[]
  outbox    OutboxRelatorio?

  @@unique([parceiroId, chaveIdempotencia])
  @@index([parceiroId, status])
  @@index([usuarioId, status])
  @@index([status, criadoEm])
}

model OutboxRelatorio {
  id             String              @id
  solicitacaoId  String              @unique
  status         StatusOutboxRelatorio @default(PENDENTE)
  criadoEm       DateTime            @default(now())
  publicadoEm    DateTime?

  solicitacao SolicitacaoRelatorio @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  @@index([status, criadoEm])
}
